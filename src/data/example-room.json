{
  "schemaVersion": 2,
  "id": "room-001",
  "template": "classic-web",
  "title": "my little corner of the internet",
  "tagline": "welcome to my digital universe ★",
  "theme": {
    "backgroundColor": "#263F88",
    "primaryColor": "#D8DCF1",
    "secondaryColor": "#A6B5E7",
    "accentColor": "#FFDF68",
    "textColor": "#202039",
    "backgroundPattern": "stars",
    "background": {
      "mode": "pattern",
      "gradient": { "from": "#263F88", "to": "#A6B5E7", "direction": "to bottom" },
      "image": { "source": null, "fit": "cover" }
    },
    "typography": {
      "headingFont": "template",
      "bodyFont": "template",
      "headingSize": "medium",
      "align": "template"
    }
  },
  "layout": {
    "widgets": [
      {
        "id": "w-about",
        "type": "about",
        "visible": true,
        "width": "half",
        "content": {
          "displayName": "internet explorer",
          "bio": "i like music, strange websites, art, and exploring the internet."
        }
      },
      {
        "id": "w-music",
        "type": "music",
        "visible": true,
        "width": "half",
        "content": {
          "music": {
            "title": "Currently exploring",
            "artist": "Internetrooms",
            "description": "A little space for sharing what I'm listening to."
          }
        }
      },
      {
        "id": "w-gallery",
        "type": "gallery",
        "visible": true,
        "width": "full",
        "content": {
          "artwork": [
            {
              "id": "art-001",
              "title": "Digital Dreams",
              "image": { "kind": "url", "url": "/assets/images/digital-dreams.svg" },
              "alt": "Abstract geometric shapes and stars against a blue background"
            }
          ]
        }
      },
      {
        "id": "w-links",
        "type": "links",
        "visible": true,
        "width": "full",
        "content": {
          "links": [
            { "id": "link-001", "label": "Internet Archive", "url": "https://archive.org" }
          ]
        }
      }
    ]
  },
  "decorations": [
    { "id": "deco-001", "kind": "pixel-star", "slot": "header-start" },
    { "id": "deco-002", "kind": "pixel-star", "slot": "header-end" }
  ]
}
